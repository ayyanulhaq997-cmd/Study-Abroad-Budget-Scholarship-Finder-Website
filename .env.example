# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# GLOBALEDU CONTACT & EDITORIAL CONFIGURATION
# ==============================================================================

# VITE_CONTACT_EMAIL: Displayed publicly and used for direct mailto links
VITE_CONTACT_EMAIL="youremail"

# VITE_CONTACT_FORM_ENDPOINT: The endpoint URL the frontend contact form posts to.
# Value: "/api/contact" (uses the built-in Vercel serverless function at /api/contact.ts)
# OR an external form handler URL like "https://formspree.io/f/your_form_id"
VITE_CONTACT_FORM_ENDPOINT="/api/contact"

# NOTIFICATION_EMAIL: Destination inbox for contact form submissions when using /api/contact
NOTIFICATION_EMAIL=""

# RESEND_API_KEY: Server-side email delivery API key for /api/contact
# Add this in Vercel Project Settings > Environment Variables (Do NOT expose to client)
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Sender email address in Resend (default: "GlobalEdu Contact <onboarding@resend.dev>")
# For production, verify your custom domain in Resend and set e.g. "GlobalEdu <contact@yourdomain.com>"
RESEND_FROM_EMAIL="GlobalEdu Contact <onboarding@resend.dev>"
